      "tools/aggregate_comments.py",
      "tools/_presets.py",
      "sqlite/db.py",
      "sqlite/loader.py",
      "sqlite/hits_backfill.py",
      "sqlite/report.py"
    ],
    "database": {
      "sqlite": "sqlite/douyin_hotpool.db",
      "schema": "sqlite/db.py",
      "note": "打包自带空库（schema 就绪），采集数据由接收方通过 loader.py 自行导入，不随包外发"
    },
    "references": [
